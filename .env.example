VITE_SUPABASE_URL=tu_url_aqui
VITE_SUPABASE_ANON_KEY=tu_key_aqui

# Extensiv 3PL — defaults for the client dropdown.
# Real credentials live as Supabase secrets, not here.
# Set with: npx supabase secrets set EXTENSIV_CLIENT_ID=... EXTENSIV_CLIENT_SECRET=... EXTENSIV_USER_LOGIN=...
VITE_EXTENSIV_CUSTOMER_ID=0
VITE_EXTENSIV_FACILITY_ID=1

# Habilita el botón "Dar de alta" (crear SKU en Extensiv) en el Paso 1 del wizard
# de Entradas. Debe ir acompañado del secret EXTENSIV_WRITE_ENABLED=true en el
# proxy. Dejar en 'false' hasta confirmar el endpoint/campos de escritura con Extensiv.
VITE_EXTENSIV_WRITE_ENABLED=false
